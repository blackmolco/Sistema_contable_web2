# Base de datos de DESARROLLO (proyecto Supabase aparte del de produccion).
#
# 1. Copia este archivo como  backend/.env.desarrollo  (ese nombre esta en
#    .gitignore: nunca se sube a GitHub).
# 2. Reemplaza los valores de abajo con los de TU proyecto de desarrollo:
#    Supabase > proyecto de desarrollo > Connect > ORMs/Prisma, o
#    Project Settings > Database > Connection string.
# 3. Todo lo que toque esta base se ejecuta con:  node scripts/dev.js <comando>
#    (ese script se niega a correr si estos datos apuntan al proyecto de
#    produccion).
#
# El .env normal (sin sufijo) sigue siendo el de PRODUCCION: solo lo usa el
# respaldo diario, que unicamente lee.

# Conexion "Transaction pooler" (puerto 6543) — la que usa la aplicacion.
DATABASE_URL="postgresql://postgres.REEMPLAZA_REF_DEL_PROYECTO:REEMPLAZA_CLAVE@aws-1-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexion "Session pooler" (puerto 5432) — la que usan las migraciones.
DIRECT_URL="postgresql://postgres.REEMPLAZA_REF_DEL_PROYECTO:REEMPLAZA_CLAVE@aws-1-us-east-2.pooler.supabase.com:5432/postgres"

# Secretos de PRUEBA (distintos a los de produccion; cualquier texto largo sirve).
JWT_SECRET="desarrollo-cambia-esto-por-un-texto-largo-y-distinto-1234567890"
ADMIN_API_TOKEN="desarrollo-token-admin-distinto"
NODE_ENV="development"
